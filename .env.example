# ---- Core ----
NODE_ENV=development                  # development | staging | production
PORT=3000
DB_URL=mongodb://localhost:27017/restomind

# ---- JWT / Auth Secrets ----
ACCESS_TOKEN_SECRET=change-me-access-secret-min-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-refresh-secret-min-32-chars
REFRESH_EXPIRES_IN=7d
RESET_PASSWORD_TOKEN_SECRET=change-me-reset-secret-min-32-chars
RESET_PASSWORD_EXPIRES_IN=15m
JWT_SETUP_SECRET=change-me-setup-secret-min-32-chars
JWT_SETUP_EXPIRES_IN=72h

# ---- CORS ----
ALLOWED_ORIGINS=https://app.restomind.com,https://admin.restomind.com

# ---- Rate Limiting ----
ENABLE_RATE_LIMIT=true
RATE_LIMIT_TTL=60                     # seconds window
RATE_LIMIT_LIMIT=100                  # requests per TTL window, global default
LOGIN_RATE_LIMIT=5                    # stricter limit for auth endpoints
AI_ENDPOINT_RATE_LIMIT=20             # limit for AI-triggering routes

# ---- Request Size Limits ----
MAX_JSON_BODY_SIZE=1mb
MAX_URLENCODED_BODY_SIZE=1mb
MAX_UPLOAD_SIZE=5                     # in MB

# ---- Security Middleware & Headers ----
ENABLE_HELMET=true
ENABLE_COMPRESSION=true
TRUST_PROXY=true                      # required behind reverse proxy / load balancer

# ---- Swagger ----
ENABLE_SWAGGER=true                   # false in production
SWAGGER_PATH=/api/docs

# ---- Logging ----
LOG_LEVEL=info                        # error | warn | info | debug

# ---- EMAIL ----
USER_EMAIL=
USER_PASS=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=

# ---- Encryption & Hashing ----
Encryption_SECRET=
SALT_ROUNDS=10

# ---- Cloudinary ----
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
CLOUD_FOLDER_NAME=

# ---- AI Microservice Integration ----
AI_SERVICE_URL=http://127.0.0.1:8200
# Sent to the AI service as `X-API-Key`. The AI service validates it against a stored
# SHA-256 hash (API_KEY_HASH); if enforcement is on and this is missing/wrong, every
# AI call 401s and forecasting silently falls back (no visible error). Leave blank for
# dev when the AI service runs with REQUIRE_API_KEY=false.
AI_API_KEY=
# Legacy alias for AI_API_KEY (old header name X-RestoMind-Key is no longer read by
# the AI service). Still read as a fallback by AiClientService; prefer AI_API_KEY and
# keep this only until you have rotated the key.
AI_SHARED_SECRET=

# ---- Scholarship AI Gateway Configuration ----
SCHOLARSHIP_API_KEY=sbg_your_scholarship_key_here
BEDROCK_GATEWAY_URL=https://your-scholarship-gateway-domain.com
AI_PROVIDER_TYPE=gateway
BEDROCK_PRIMARY_LLM=anthropic.claude-sonnet-4-6
BEDROCK_ROUTER_LLM=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_PRIMARY_EMBEDDING=us.cohere.embed-v4:0
BEDROCK_FALLBACK_EMBEDDING=amazon.titan-embed-text-v2:0:8k



NOTIFICATION_RETENTION_DAYS=90

# ---- Public URLs (required by the payment flow) ----
# An unset value would put the literal string "undefined" into Paymob's
# callback URL. API_PUBLIC_URL must be reachable from the public internet,
# not localhost, or no webhook ever arrives.
API_PUBLIC_URL=
FRONTEND_URL=

# ---- Paymob ----
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
# Dashboard -> Settings -> Payment Integrations. Card is 5752819 in test mode.
PAYMOB_INTEGRATION_ID_CARD=
# Leave blank until a Mobile Wallet integration is enabled for Vodafone Cash.
# NOTE: notification_url on the Intention applies to CARD integrations ONLY.
# The wallet integration's callback URL must be set in the Paymob dashboard,
# otherwise wallet payments produce no webhook at all and are resolved solely
# by the reconciliation sweeper.
PAYMOB_INTEGRATION_ID_WALLET=
# Minutes an abandoned checkout may hold its reserved stock before the order is
# auto-cancelled and the stock returned. Drives the Paymob intention lifetime,
# the reconciliation sweeper's grace period, and the "one live checkout per
# customer" guard — all three move together. Default 5.
# Too low and a customer still typing a 3DS/OTP code is rejected mid-payment.
PAYMENT_WINDOW_MINUTES=5
